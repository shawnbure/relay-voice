{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-voice-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "vars": { "ENVIRONMENT": "development", "WEB_ORIGIN": "http://localhost:5173" },
  "d1_databases": [
    { "binding": "DB", "database_name": "relay-voice", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "relay-voice-media" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EVENTS", "class_name": "RelayEvents" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayEvents"] }]
}
